* text=auto
# Unity serializes empty material properties with a trailing space.
Prototypes/JosueAlpha/Unity/Assets/**/*.mat whitespace=-trailing-space
Unity/Assets/**/*.mat whitespace=-trailing-space
*.cs text eol=lf
*.java text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.md text eol=lf
# Preserve Unity's serialized blank values without whitespace-check noise.
*.unity text eol=lf whitespace=-blank-at-eol
*.prefab text eol=lf whitespace=-blank-at-eol
*.asset text eol=lf whitespace=-blank-at-eol
*.meta text eol=lf whitespace=-blank-at-eol
*.sh text eol=lf
mvnw text eol=lf
mvnw.cmd text eol=crlf
# Preserve the authentic upstream copyright text byte-for-byte.
docs/evidence/t016-camera-runtime-2026-10-09/profile/authentic-notices/Python-copyright.txt whitespace=-blank-at-eol
