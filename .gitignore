# Preparación documental: sólo residuos locales conocidos.
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Añadir ignores de Unity/.NET/frontend cuando existan esos proyectos.
# Conservar Assets, .meta, Packages, ProjectSettings y configuraciones necesarias.

# Herramientas Python de gestión
__pycache__/
*.pyc

# Unity generated files; source assets and .meta remain tracked
/Unity/[Ll]ibrary/
/Unity/[Tt]emp/
/Unity/[Oo]bj/
/Unity/[Ll]ogs/
/Unity/[Uu]ser[Ss]ettings/
/Unity/Builds/
/Unity/*.csproj
/Unity/*.sln
# Regenerated defaults for unused systems, or local editor/UI state.
/Unity/ProjectSettings/PackageManagerSettings.asset
/Unity/ProjectSettings/Packages/com.unity.ai.assistant/
/Unity/ProjectSettings/SceneTemplateSettings.json
/Unity/ProjectSettings/ClusterInputManager.asset
/Unity/ProjectSettings/MemorySettings.asset
/Unity/ProjectSettings/MultiplayerManager.asset
/Unity/ProjectSettings/NavMeshAreas.asset
/Unity/ProjectSettings/Physics2DSettings.asset
/Unity/ProjectSettings/PresetManager.asset
/Unity/ProjectSettings/VFXManager.asset
/Unity/ProjectSettings/VersionControlSettings.asset
# Java and frontend outputs
**/target/
/PWA/node_modules/
/PWA/dist/
.env
.env.*
!.env.example
*.pfx
*.p12
*.jks
