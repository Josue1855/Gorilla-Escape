# Preparación documental: sólo residuos locales conocidos.
.DS_Store
Thumbs.db
*~
*.swp
*.swo

# Añadir ignores de Unity/.NET/frontend cuando existan esos proyectos.
# Conservar Assets, .meta, Packages, ProjectSettings y configuraciones necesarias.

# Herramientas Python de gestión
__pycache__/
*.pyc

# Unity generated files; source assets and .meta remain tracked
/Unity/[Ll]ibrary/
/Unity/[Tt]emp/
/Unity/[Oo]bj/
/Unity/[Ll]ogs/
/Unity/[Uu]ser[Ss]ettings/
/Unity/Builds/
/Unity/*.csproj
/Unity/*.sln
/Unity/*.slnx
/Unity/CameraTracker/.venv/
/Unity/CameraTracker/vendor/
/Unity/CameraTracker/.runtime/
/Unity/CameraTracker/.downloads/
/Unity/MotionRelay/cloudflared.exe
/Unity/python-install*.log
/Unity/*-compile.log
/Unity/Assets/_Recovery/

# La biblioteca compartida conserva fuentes, no residuos de herramientas.
/assets/**/__pycache__/

# Prototipo alpha aislado de Josue
/Prototypes/JosueAlpha/Unity/[Ll]ibrary/
/Prototypes/JosueAlpha/Unity/[Tt]emp/
/Prototypes/JosueAlpha/Unity/[Oo]bj/
/Prototypes/JosueAlpha/Unity/[Ll]ogs/
/Prototypes/JosueAlpha/Unity/[Uu]ser[Ss]ettings/
/Prototypes/JosueAlpha/Unity/[Bb]uild/
/Prototypes/JosueAlpha/Unity/[Bb]uilds/
/Prototypes/JosueAlpha/Unity/Assets/_Recovery/
/Prototypes/JosueAlpha/Unity/*.csproj
/Prototypes/JosueAlpha/Unity/*.sln*
/Prototypes/JosueAlpha/CameraTracker/.venv/
/Prototypes/JosueAlpha/CameraTracker/vendor/
/Prototypes/JosueAlpha/CameraTracker/.runtime/
/Prototypes/JosueAlpha/CameraTracker/.downloads/
/Prototypes/JosueAlpha/MotionRelay/cloudflared.exe
