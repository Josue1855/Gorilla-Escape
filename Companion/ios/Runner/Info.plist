			<key>CFBundleIconFiles</key>
			<array>
				<string>Icon-App-60x60</string>
			</array>
		</dict>
	</dict>
	<key>CFBundleIcons~ipad</key>
	<dict>
		<key>CFBundlePrimaryIcon</key>
		<dict>
			<key>CFBundleIconFiles</key>
			<array>
				<string>Icon-App-76x76</string>
				<string>Icon-App-83.5x83.5</string>
			</array>
		</dict>
	</dict>
